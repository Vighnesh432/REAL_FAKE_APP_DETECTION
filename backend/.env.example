# Copy to .env and change these before any real deployment.
SECRET_KEY=replace-with-a-long-random-string
TOKEN_EXPIRE_MINUTES=720
DATABASE_URL=sqlite:///./app.db
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@appxray.io
ADMIN_PASSWORD=change-me-before-deploying
# 0.0 = pure ML classifier, 1.0 = pure rule engine. Default blends both because the
# classifier is trained on synthetic listings and needs the rule engine to stay
# reliable on real Play Store / website text.
RULE_WEIGHT=0.45
